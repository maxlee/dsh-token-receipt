{
  "name": "@maxlee/dsh-token-receipt",
  "version": "1.0.0",
  "private": false,
  "description": "Print daily, weekly, or monthly token usage as a tactile receipt and save it as a PNG.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "assets",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "README.zh.md",
    "RELEASING.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "license": "MIT",
  "author": "maxlee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxlee/dsh-token-receipt.git"
  },
  "homepage": "https://github.com/maxlee/dsh-token-receipt",
  "bugs": {
    "url": "https://github.com/maxlee/dsh-token-receipt/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "token",
    "usage",
    "receipt",
    "printer",
    "png"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "icon": "icon.svg",
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "prepublishOnly": "npm run check"
  }
}